# 服务
APP_PORT=8099
APP_HOST=0.0.0.0

# MySQL（与 Java 版共用同一库）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=ai-agent-station-study

# OpenAI 兼容 API（可被数据库 ai_client_api 覆盖）
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-api-key

# 启动时自动装配所有 Agent
AUTO_ARMORY_ENABLED=true
